<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sefaria Commentary Downloader</title>
<style>
  :root{
    --bg:#f6f7f9; --panel:#ffffff; --ink:#16181d; --muted:#6b7280;
    --line:#e2e5ea; --accent:#2f6fed; --accent-ink:#ffffff;
    --ok:#16a34a; --bad:#dc2626; --warn:#b45309; --soft:#eef2f8;
    --hebrew:"Segoe UI","Arial Hebrew","Noto Sans Hebrew",David,"Times New Roman",serif;
  }
  @media (prefers-color-scheme:dark){
    :root{
      --bg:#0f1115; --panel:#171a21; --ink:#e8eaef; --muted:#9aa3b2;
      --line:#262b35; --accent:#4c8dff; --accent-ink:#0b0d11;
      --ok:#4ade80; --bad:#f87171; --warn:#fbbf24; --soft:#1d222c;
    }
  }
  *{box-sizing:border-box}
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font:15px/1.5 "Segoe UI",system-ui,-apple-system,sans-serif;
    height:100vh; display:flex; flex-direction:column; overflow:hidden;
  }
  header{
    padding:12px 20px; border-bottom:1px solid var(--line); background:var(--panel);
    display:flex; align-items:center; gap:14px; flex-wrap:wrap; flex:none;
  }
  h1{font-size:16px; margin:0; font-weight:650; letter-spacing:-.01em}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--muted);flex:none}
  .dot.on{background:var(--ok)} .dot.off{background:var(--bad)}
  #status{color:var(--muted); font-size:13px; display:flex; align-items:center; gap:7px}
  .spacer{flex:1}

  input,select,button{
    font:inherit; font-size:13px; color:var(--ink); background:var(--soft);
    border:1px solid var(--line); border-radius:8px; padding:7px 11px;
  }
  button{cursor:pointer}
  select:hover,button:hover:not(:disabled){border-color:var(--accent)}
  input:focus,select:focus{outline:none;border-color:var(--accent)}
  button.primary{background:var(--accent); color:var(--accent-ink); border-color:var(--accent); font-weight:600}
  button:disabled{opacity:.45; cursor:not-allowed}
  button.ghost{background:transparent}

  main{flex:1; display:grid; grid-template-columns:270px 300px 1fr; min-height:0}
  @media (max-width:1000px){ main{grid-template-columns:200px 230px 1fr} }
  .col{display:flex; flex-direction:column; min-height:0; min-width:0; background:var(--panel)}
  .col + .col{border-left:1px solid var(--line)}
  .col h2{
    font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:var(--muted);
    margin:0; padding:11px 14px 8px; font-weight:600; flex:none;
    display:flex; align-items:center; gap:8px;
  }
  .col h2 .count{font-weight:400; text-transform:none; letter-spacing:0}
  .search{margin:0 12px 8px; padding:6px 10px; width:calc(100% - 24px); flex:none}
  .list{flex:1; overflow-y:auto; padding:0 8px 12px}
  .item{
    padding:7px 10px; border-radius:7px; cursor:pointer; font-size:13px;
    display:flex; align-items:baseline; gap:8px; border:1px solid transparent;
  }
  .item:hover{background:var(--soft)}
  .item.sel{background:var(--accent); color:var(--accent-ink); border-color:var(--accent)}
  .item .he{font-family:var(--hebrew); color:var(--muted); font-size:12px; margin-inline-start:auto; direction:rtl; unicode-bidi:isolate}
  .item.sel .he{color:var(--accent-ink); opacity:.8}
  .item .cat{font-size:11px; color:var(--muted); display:block}
  .item.sel .cat{color:var(--accent-ink); opacity:.75}
  .item .nm{min-width:0; overflow:hidden; text-overflow:ellipsis}
  .hint{padding:14px; color:var(--muted); font-size:12.5px; line-height:1.6}

  /* ---- library drill-down ---- */
  .crumbs{
    padding:0 12px 8px; font-size:11.5px; color:var(--muted); flex:none;
    display:flex; flex-wrap:wrap; gap:3px; align-items:center; line-height:1.7;
  }
  .crumbs a{color:var(--accent); cursor:pointer; text-decoration:none}
  .crumbs a:hover{text-decoration:underline}
  .crumbs .sep{opacity:.5}
  .crumbs .here{color:var(--ink); font-weight:600}
  .item.dir{font-weight:600}
  .item.dir .arrow{flex:none; color:var(--muted); font-size:11px}
  .item.dir.sel .arrow{color:var(--accent-ink)}
  .item .kids{
    flex:none; font-size:10.5px; color:var(--muted); background:var(--soft);
    border-radius:99px; padding:1px 7px; margin-inline-start:auto;
  }
  .item.sel .kids{background:transparent; color:var(--accent-ink); opacity:.8}
  .item.up{color:var(--muted)}
  .grouphead{
    padding:10px 10px 4px; font-size:10.5px; text-transform:uppercase;
    letter-spacing:.07em; color:var(--muted); font-weight:700;
  }

  /* ---- reader ---- */
  .rbar{
    padding:10px 16px; border-bottom:1px solid var(--line); flex:none;
    display:flex; gap:8px; align-items:center; flex-wrap:wrap;
  }
  .rtitle{font-weight:650; font-size:14px}
  .rtitle .he{font-family:var(--hebrew); color:var(--muted); font-weight:400; margin-inline-start:8px; direction:rtl; unicode-bidi:isolate}

  .meter{
    padding:9px 16px; border-bottom:1px solid var(--line); flex:none;
    display:flex; gap:10px; align-items:center; flex-wrap:wrap; font-size:12.5px;
  }
  .bar{flex:1; min-width:120px; height:6px; border-radius:99px; background:var(--soft); overflow:hidden}
  .bar > i{display:block; height:100%; width:0; background:var(--accent); transition:width .2s}
  .badge{
    font-size:11px; font-weight:700; letter-spacing:.04em; text-transform:uppercase;
    padding:3px 9px; border-radius:99px; border:1px solid;
  }
  .badge.full{color:var(--ok); border-color:var(--ok)}
  .badge.part{color:var(--warn); border-color:var(--warn)}
  .badge.busy{color:var(--muted); border-color:var(--line)}
  .badge.err{color:var(--bad); border-color:var(--bad)}
  .lic{font-size:11.5px; color:var(--muted)}
  .lic b{color:var(--ink); font-weight:600}

  #reader{
    flex:1; overflow-y:auto; padding:6px 0 40px;
    font-family:var(--hebrew); font-size:17px; line-height:1.8;
  }
  .sect{padding:14px 22px 4px; font-size:11px; text-transform:uppercase;
        letter-spacing:.08em; color:var(--muted); font-family:"Segoe UI",system-ui,sans-serif;
        font-weight:600; position:sticky; top:0; background:var(--panel);
        border-bottom:1px solid var(--line); margin-bottom:6px}
  .seg{padding:5px 22px; display:flex; gap:12px; align-items:baseline}
  .seg:hover{background:var(--soft)}
  .seg .n{
    flex:none; font-family:"Segoe UI",system-ui,sans-serif; font-size:11px;
    color:var(--muted); min-width:62px; text-align:end; padding-top:4px;
    direction:ltr; unicode-bidi:isolate;
  }
  .seg .t{flex:1; min-width:0; text-align:start; word-wrap:break-word}
  .seg.gap .t{color:var(--muted); font-style:italic; font-size:14px;
              font-family:"Segoe UI",system-ui,sans-serif}
  .seg .t sup{font-size:.7em; color:var(--accent)}
  .seg .t i.footnote{display:block; font-size:13px; color:var(--muted); margin-top:3px}
  #reader .empty{padding:40px 24px; color:var(--muted); font-family:"Segoe UI",system-ui,sans-serif;
                 font-size:13.5px; line-height:1.7; max-width:60ch}
  #reader .empty h3{font-size:15px; color:var(--ink); margin:0 0 8px}
  #reader .empty code{background:var(--soft); padding:1px 5px; border-radius:4px; font-size:12px}

  footer{
    padding:9px 16px; border-top:1px solid var(--line); background:var(--panel);
    display:flex; gap:8px; align-items:center; flex-wrap:wrap; flex:none; font-size:12px;
  }
  #note{color:var(--muted); font-size:12px}
  #note.bad{color:var(--bad)} #note.ok{color:var(--ok)}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
</head>
<body>

<header>
  <h1>Sefaria Commentary Downloader</h1>
  <div id="status"><span class="dot" id="dot"></span><span id="statusTxt">connecting…</span></div>
  <div class="spacer"></div>
  <button class="ghost" id="btnClearSel" title="Start over">Reset</button>
</header>

<main>
  <!-- ---------------- books ---------------- -->
  <section class="col">
    <h2>1 · Library <span class="count" id="bookCount"></span></h2>
    <input class="search" id="bookSearch" placeholder="Search every book…" autocomplete="off">
    <div class="crumbs" id="crumbs"></div>
    <div class="list" id="bookList"><div class="hint">Loading Sefaria's library…</div></div>
  </section>

  <!-- ---------------- commentaries ---------------- -->
  <section class="col">
    <h2>2 · Commentary <span class="count" id="commCount"></span></h2>
    <input class="search" id="commSearch" placeholder="Filter commentaries…" autocomplete="off">
    <div class="list" id="commList"><div class="hint">Pick a book on the left.</div></div>
  </section>

  <!-- ---------------- reader ---------------- -->
  <section class="col">
    <div class="rbar">
      <span class="rtitle" id="rTitle">3 · Full text</span>
      <div class="spacer"></div>
      <label class="sr" for="verSel">Version</label>
      <select id="verSel" disabled><option>—</option></select>
      <button id="btnLoad" disabled>Load full text</button>
      <button class="ghost" id="btnStop" disabled>Stop</button>
    </div>

    <div class="meter">
      <span class="badge busy" id="badge">idle</span>
      <div class="bar"><i id="barFill"></i></div>
      <span id="mText">—</span>
      <span class="spacer"></span>
      <span class="lic" id="licTxt"></span>
    </div>

    <div id="reader">
      <div class="empty">
        <h3>How this works</h3>
        <p>Pick a <b>book</b>, then a <b>commentary</b> on it. The whole commentary
        loads into this pane so you can scroll and read it before committing to
        anything.</p>
        <p>The bar above tracks coverage against Sefaria's own segment count for
        that work. It reads <b>COMPLETE</b> only when every section came back with
        text; otherwise it says <b>PARTIAL</b> and lists what is missing. Download
        stays available either way — you just always know which one you are getting.</p>
        <p>Downloads land in your browser's Downloads folder, or next to this app in
        <code>sefaria_downloads\</code> via <b>Save to folder</b>.</p>
      </div>
    </div>

    <footer>
      <button class="primary" id="dlTxt" disabled>Download .txt</button>
      <button id="dlMd" disabled>.md</button>
      <button id="dlJson" disabled>.json</button>
      <button class="ghost" id="dlSave" disabled>Save to folder</button>
      <span class="spacer"></span>
      <span id="note"></span>
    </footer>
  </section>
</main>

<script>
"use strict";
const $ = s => document.querySelector(s);

const el = {
  dot: $("#dot"), statusTxt: $("#statusTxt"),
  bookList: $("#bookList"), bookSearch: $("#bookSearch"), bookCount: $("#bookCount"),
  crumbs: $("#crumbs"),
  commList: $("#commList"), commSearch: $("#commSearch"), commCount: $("#commCount"),
  rTitle: $("#rTitle"), verSel: $("#verSel"), btnLoad: $("#btnLoad"), btnStop: $("#btnStop"),
  badge: $("#badge"), barFill: $("#barFill"), mText: $("#mText"), licTxt: $("#licTxt"),
  reader: $("#reader"), note: $("#note"),
  dlTxt: $("#dlTxt"), dlMd: $("#dlMd"), dlJson: $("#dlJson"), dlSave: $("#dlSave"),
};

/* Everything about the download currently on screen. `sections` is kept in ref
   order regardless of the order responses arrive in, so the reader and every
   export read top-to-bottom correctly. */
let toc = [], flat = [], path = [];   // library tree, search index, current trail
let bookSel = null, comms = [], commSel = null;
let book = null;                 // /api/book payload for the selected commentary
let run = null;                  // { abort, sections, done, segs, chars, missing }

// ---------------------------------------------------------------- helpers

function say(msg, kind) {
  el.note.textContent = msg || "";
  el.note.className = kind || "";
}

async function api(path) {
  const r = await fetch(path);
  const d = await r.json().catch(() => ({ ok: false, error: "bad JSON from server" }));
  if (!d.ok) throw new Error(d.error || ("HTTP " + r.status));
  return d;
}

/* Sefaria segments carry light markup (<b>, <i>, <sup>, footnotes). Keep the
   formatting, drop anything executable. */
const ALLOWED = new Set(["B","I","EM","STRONG","SUP","SUB","BIG","SMALL","SPAN","BR","U"]);
function sanitize(html) {
  const box = document.createElement("div");
  box.innerHTML = String(html == null ? "" : html);
  for (const node of [...box.querySelectorAll("*")]) {
    if (!ALLOWED.has(node.tagName)) { node.replaceWith(...node.childNodes); continue; }
    for (const a of [...node.attributes]) {
      if (a.name !== "class") node.removeAttribute(a.name);
    }
  }
  return box.innerHTML;
}

function plain(html) {
  const box = document.createElement("div");
  box.innerHTML = String(html == null ? "" : html)
    .replace(/<\/(p|div|li|h\d)>/gi, "\n")
    .replace(/<br\s*\/?>/gi, "\n");
  return (box.textContent || "").replace(/[ \t]+/g, " ").replace(/\n{3,}/g, "\n\n").trim();
}

function isHebrewish(s) { return /[֐-׿]/.test(s || ""); }

function download(name, text, mime) {
  const url = URL.createObjectURL(new Blob([text], { type: (mime || "text/plain") + ";charset=utf-8" }));
  const a = document.createElement("a");
  a.href = url; a.download = name;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 4000);
}

function slug(s) { return String(s).replace(/[^\w֐-׿]+/g, "_").replace(/^_|_$/g, ""); }

// ---------------------------------------------------------------- 1. books

function escapeHtml(s) {
  return String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
}

const isDir = n => Array.isArray(n.contents);
const dirName = n => n.category || n.heCategory || "";

async function loadToc() {
  try {
    const d = await api("/api/toc");
    toc = (d.toc || []).filter(n => isDir(n) || n.title);
    // A flat index alongside the tree, so search can cut across the whole
    // library without the user having to know where a book lives.
    flat = [];
    (function walk(nodes, trail) {
      for (const n of nodes || []) {
        if (isDir(n)) walk(n.contents, trail.concat(dirName(n)));
        else if (n.title) flat.push({
          title: n.title, he: n.heTitle || "",
          cat: trail.filter(Boolean).join(" › "),
        });
      }
    })(toc, []);
    flat.sort((a, b) => a.title.localeCompare(b.title));
    path = [];
    el.dot.className = "dot on";
    el.statusTxt.textContent = "Sefaria reachable · " + flat.length.toLocaleString() + " texts";
    renderLibrary();
  } catch (e) {
    el.dot.className = "dot off";
    el.statusTxt.textContent = "offline";
    el.bookList.innerHTML = '<div class="hint">Could not load the library.<br><br>' +
      escapeHtml(e.message) + "</div>";
  }
}

/* Where we currently are in the tree. */
function here() {
  return path.length ? path[path.length - 1].contents : toc;
}

function renderCrumbs() {
  if (el.bookSearch.value.trim()) {
    el.crumbs.innerHTML = '<span class="here">Search results</span>' +
      '<span class="sep">·</span><a data-i="-1">clear</a>';
  } else if (!path.length) {
    el.crumbs.innerHTML = '<span class="here">Library</span>';
  } else {
    const parts = ['<a data-i="-1">Library</a>'];
    path.forEach((n, i) => {
      parts.push('<span class="sep">›</span>');
      parts.push(i === path.length - 1
        ? '<span class="here">' + escapeHtml(dirName(n)) + "</span>"
        : '<a data-i="' + i + '">' + escapeHtml(dirName(n)) + "</a>");
    });
    el.crumbs.innerHTML = parts.join("");
  }
  el.crumbs.querySelectorAll("a").forEach(a => a.onclick = () => {
    const i = +a.dataset.i;
    el.bookSearch.value = "";
    path = i < 0 ? [] : path.slice(0, i + 1);
    renderLibrary();
  });
}

function renderLibrary() {
  renderCrumbs();
  const qs = el.bookSearch.value.trim().toLowerCase();

  if (qs) return renderSearch(qs);

  const nodes = here();
  const dirs = nodes.filter(isDir);
  const leaves = nodes.filter(n => !isDir(n) && n.title);
  el.bookCount.textContent = (dirs.length ? dirs.length + " sections" : "") +
    (dirs.length && leaves.length ? " · " : "") +
    (leaves.length ? leaves.length + " texts" : "");

  let html = "";
  if (path.length) {
    html += '<div class="item up" data-up="1"><span class="arrow">↑</span>' +
            '<span class="nm">Back</span></div>';
  }
  if (dirs.length) {
    if (leaves.length) html += '<div class="grouphead">Sections</div>';
    html += dirs.map((n, i) =>
      '<div class="item dir" data-dir="' + i + '">' +
        '<span class="arrow">▸</span>' +
        '<span class="nm">' + escapeHtml(dirName(n)) + "</span>" +
        (n.heCategory ? '<span class="he">' + escapeHtml(n.heCategory) + "</span>" : "") +
        '<span class="kids">' + n.contents.length + "</span>" +
      "</div>").join("");
  }
  if (leaves.length) {
    if (dirs.length) html += '<div class="grouphead">Texts</div>';
    html += leaves.map(n =>
      '<div class="item' + (bookSel === n.title ? " sel" : "") + '" data-t="' +
        escapeHtml(n.title) + '">' +
        '<span class="nm">' + escapeHtml(n.title) + "</span>" +
        (n.heTitle ? '<span class="he">' + escapeHtml(n.heTitle) + "</span>" : "") +
      "</div>").join("");
  }
  el.bookList.innerHTML = html || '<div class="hint">Nothing here.</div>';

  el.bookList.querySelectorAll("[data-up]").forEach(n =>
    n.onclick = () => { path.pop(); renderLibrary(); });
  el.bookList.querySelectorAll("[data-dir]").forEach(n =>
    n.onclick = () => { path.push(dirs[+n.dataset.dir]); el.bookList.scrollTop = 0; renderLibrary(); });
  el.bookList.querySelectorAll("[data-t]").forEach(n =>
    n.onclick = () => pickBook(n.dataset.t));
}

function renderSearch(qs) {
  const hit = flat.filter(b => b.title.toLowerCase().includes(qs) ||
                               b.he.includes(qs) ||
                               b.cat.toLowerCase().includes(qs));
  el.bookCount.textContent = hit.length + " / " + flat.length;
  const view = hit.slice(0, 300);
  el.bookList.innerHTML = view.length
    ? view.map(b =>
        '<div class="item' + (bookSel === b.title ? " sel" : "") + '" data-t="' +
          escapeHtml(b.title) + '">' +
          '<span class="nm">' + escapeHtml(b.title) +
            '<span class="cat">' + escapeHtml(b.cat) + "</span></span>" +
          (b.he ? '<span class="he">' + escapeHtml(b.he) + "</span>" : "") +
        "</div>").join("") +
      (hit.length > view.length
        ? '<div class="hint">…' + (hit.length - view.length) + " more. Keep typing to narrow.</div>" : "")
    : '<div class="hint">Nothing matches that.</div>';
  el.bookList.querySelectorAll("[data-t]").forEach(n =>
    n.onclick = () => pickBook(n.dataset.t));
}

// ---------------------------------------------------------------- 2. commentaries

async function pickBook(title) {
  bookSel = title;
  commSel = null;
  renderLibrary();
  resetReader();
  el.commCount.textContent = "";
  el.commList.innerHTML = '<div class="hint">Finding commentaries on <b>' +
    escapeHtml(title) + "</b>…<br><br>Sampling link data across the whole book, " +
    "so commentators who only appear in later chapters still show up. " +
    "First look at a book takes a few seconds; after that it is cached.</div>";
  try {
    const d = await api("/api/commentaries?title=" + encodeURIComponent(title) + "&samples=14");
    comms = d.commentaries || [];
    renderComms(d);
  } catch (e) {
    el.commList.innerHTML = '<div class="hint">Could not list commentaries.<br><br>' +
      escapeHtml(e.message) + "</div>";
  }
}

function renderComms(meta) {
  const qs = el.commSearch.value.trim().toLowerCase();
  const hit = qs ? comms.filter(c => c.name.toLowerCase().includes(qs) ||
                                     c.indexTitle.toLowerCase().includes(qs) ||
                                     (c.heName || "").includes(qs)) : comms;
  el.commCount.textContent = qs ? hit.length + " / " + comms.length : comms.length;

  // The base text itself is always offered first. Having drilled down to
  // Berakhot or Genesis, wanting to read and download *that* is at least as
  // likely as wanting a commentary on it.
  const self = '<div class="grouphead">The text itself</div>' +
    '<div class="item' + (commSel === bookSel ? " sel" : "") + '" data-t="' +
      escapeHtml(bookSel) + '"><span class="nm">' + escapeHtml(bookSel) +
      '<span class="cat">the base text, not a commentary</span></span></div>';

  if (!comms.length) {
    el.commList.innerHTML = self +
      '<div class="hint">Sefaria lists no commentaries linked to this text.</div>';
    el.commList.querySelectorAll("[data-t]").forEach(n =>
      n.onclick = () => pickComm(n.dataset.t));
    return;
  }
  const rows = hit.map(c =>
    '<div class="item' + (commSel === c.indexTitle ? " sel" : "") + '" data-t="' + escapeHtml(c.indexTitle) + '">' +
      '<span class="nm">' + escapeHtml(c.name) +
        '<span class="cat">' + escapeHtml(c.indexTitle) + "</span></span>" +
      (c.heName ? '<span class="he">' + escapeHtml(c.heName) + "</span>" : "") +
    "</div>").join("");
  el.commList.innerHTML = self + '<div class="grouphead">Commentaries</div>' +
    (rows || '<div class="hint">No commentary matches that filter.</div>');

  if (meta && meta.sampledSections) {
    el.commList.insertAdjacentHTML("beforeend",
      '<div class="hint">Sampled ' + meta.sampledSections + " of " + meta.totalSections +
      " sections. Rare commentators may be missed — use the filter box to search by name.</div>");
  }
  el.commList.querySelectorAll(".item").forEach(n =>
    n.onclick = () => pickComm(n.dataset.t));
}

async function pickComm(indexTitle) {
  commSel = indexTitle;
  renderComms();
  resetReader();
  el.rTitle.textContent = indexTitle;
  el.reader.innerHTML = '<div class="empty">Reading the structure of <b>' +
    escapeHtml(indexTitle) + "</b>…</div>";
  try {
    book = await api("/api/book?title=" + encodeURIComponent(indexTitle));
    el.rTitle.innerHTML = escapeHtml(book.title) +
      (book.heTitle ? '<span class="he">' + escapeHtml(book.heTitle) + "</span>" : "");
    fillVersions(book.versions);
    el.btnLoad.disabled = false;
    el.mText.textContent = book.sections + " sections · " +
      (book.expectedSegments || "?") + " segments in the original";
    el.reader.innerHTML = '<div class="empty"><h3>Ready</h3><p><b>' +
      escapeHtml(book.title) + "</b> has " + book.sections + " sections and " +
      (book.expectedSegments || "?") + " comment segments in the original.</p>" +
      "<p>Choose a version above, then hit <b>Load full text</b> to pull it all in and read it here. " +
      "Translations often cover fewer segments than the original — that is normal, and the " +
      "check below accounts for it.</p></div>";
    say("");
  } catch (e) {
    el.reader.innerHTML = '<div class="empty"><h3>Could not open that</h3><p>' +
      escapeHtml(e.message) + "</p></div>";
  }
}

function fillVersions(versions) {
  const vs = versions || [];
  el.verSel.innerHTML = "";
  // Sensible defaults first: they always resolve even when no version is named.
  const add = (val, label) => {
    const o = document.createElement("option");
    o.value = val; o.textContent = label;
    el.verSel.appendChild(o);
  };
  add("english", "English (Sefaria's default)");
  add("hebrew", "Hebrew / original");
  if (vs.length) {
    const g = document.createElement("optgroup");
    g.label = "Specific versions";
    for (const v of vs) {
      const o = document.createElement("option");
      o.value = v.selector;
      o.textContent = v.versionTitle + "  [" + (v.actualLanguage || v.language) + " · " + v.license + "]";
      o.dataset.license = v.license;
      o.dataset.source = v.source || "";
      g.appendChild(o);
    }
    el.verSel.appendChild(g);
  }
  el.verSel.disabled = false;
  showLicense();
}

function showLicense() {
  const o = el.verSel.selectedOptions[0];
  const lic = o && o.dataset.license;
  el.licTxt.innerHTML = lic
    ? "License: <b>" + escapeHtml(lic) + "</b>"
    : "License shown once text loads";
}

// ---------------------------------------------------------------- 3. load full text

function resetReader() {
  if (run) run.abort = true;
  run = null;
  book = null;
  el.verSel.disabled = true; el.verSel.innerHTML = "<option>—</option>";
  el.btnLoad.disabled = true; el.btnStop.disabled = true;
  el.badge.className = "badge busy"; el.badge.textContent = "idle";
  el.barFill.style.width = "0"; el.mText.textContent = "—"; el.licTxt.textContent = "";
  setExports(false);
  say("");
}

function setExports(on) {
  for (const b of [el.dlTxt, el.dlMd, el.dlJson, el.dlSave]) b.disabled = !on;
}

async function loadFull() {
  if (!book || !book.refs.length) return;
  const version = el.verSel.value;
  const state = run = {
    abort: false, version,
    sections: new Array(book.refs.length).fill(null),
    done: 0, segs: 0, chars: 0,
    gaps: [],      // source has content here, this version returned none
    failed: [],    // the request itself failed
    license: "", versionTitle: "", dir: "ltr",
  };

  el.btnLoad.disabled = true; el.btnStop.disabled = false;
  setExports(false);
  el.reader.innerHTML = "";
  el.badge.className = "badge busy"; el.badge.textContent = "loading";
  say("");

  // Placeholders up front so sections render in ref order no matter which
  // response lands first.
  const frag = document.createDocumentFragment();
  book.refs.forEach((ref, i) => {
    const wrap = document.createElement("div");
    wrap.id = "s" + i;
    wrap.innerHTML = '<div class="sect">' + escapeHtml(ref) + "</div>" +
                     '<div class="seg gap"><span class="n"></span><span class="t">loading…</span></div>';
    frag.appendChild(wrap);
  });
  el.reader.appendChild(frag);

  const CONC = 4;                        // matches the server's upstream gate
  let next = 0;
  const worker = async () => {
    while (!state.abort) {
      const i = next++;
      if (i >= book.refs.length) return;
      const ref = book.refs[i];
      try {
        const d = await api("/api/text?ref=" + encodeURIComponent(ref) +
                            "&version=" + encodeURIComponent(version));
        if (state.abort) return;
        state.sections[i] = d;
        if (d.license && !state.license) {
          state.license = d.license;
          state.versionTitle = d.versionTitle || "";
          state.dir = d.direction || "ltr";
        }
        const real = (d.segments || []).filter(s => plain(s.text).length);
        state.segs += real.length;
        for (const s of real) state.chars += plain(s.text).length;
        // A gap is a section the source says has content but this version
        // returned nothing for. A section that is empty in the source too is
        // not a gap — there is simply no comment there.
        if (!real.length && expectedAt(i) > 0) state.gaps.push(ref);
        paintSection(i, ref, d);
      } catch (e) {
        if (state.abort) return;
        state.sections[i] = { ref, segments: [], error: e.message };
        state.failed.push(ref);
        paintSection(i, ref, { segments: [], error: e.message });
      }
      state.done++;
      progress(state);
    }
  };

  await Promise.all(Array.from({ length: CONC }, worker));
  if (state.abort) { say("Stopped. Partial text is still on screen and downloadable."); }
  finish(state);
}

function paintSection(i, ref, d) {
  const wrap = document.getElementById("s" + i);
  if (!wrap) return;
  const segs = (d.segments || []).filter(s => plain(s.text).length);
  let html = '<div class="sect">' + escapeHtml(ref) +
             (segs.length ? "  ·  " + segs.length + (segs.length === 1 ? " comment" : " comments") : "") +
             "</div>";
  if (d.error) {
    html += '<div class="seg gap"><span class="n">!</span><span class="t">failed: ' +
            escapeHtml(d.error) + "</span></div>";
  } else if (!segs.length) {
    html += '<div class="seg gap"><span class="n">—</span><span class="t">no text in this version</span></div>';
  } else {
    for (const s of segs) {
      const label = s.ref.startsWith(ref) ? s.ref.slice(ref.length).replace(/^:/, "") : s.ref;
      const body = sanitize(s.text);
      html += '<div class="seg"><span class="n">' + escapeHtml(label || "•") +
              '</span><span class="t" dir="auto">' + body + "</span></div>";
    }
  }
  wrap.innerHTML = html;
}

/* How many segments the source structure has in section i. Sefaria's shape
   describes the primary text, so this is a yardstick, not a quota. */
function expectedAt(i) {
  return (book && book.perSection && book.perSection[i]) || 0;
}

function progress(state) {
  const pct = Math.round(100 * state.done / book.refs.length);
  el.barFill.style.width = pct + "%";
  el.mText.textContent = state.done + " / " + book.refs.length + " sections · " +
    state.segs + " segments · " + state.chars.toLocaleString() + " chars";
  if (state.license) {
    el.licTxt.innerHTML = "License: <b>" + escapeHtml(state.license) + "</b>" +
      (state.versionTitle ? " · " + escapeHtml(state.versionTitle) : "");
  }
}

/* The completeness verdict.
 *
 * The obvious test — "did we get as many segments as Sefaria's shape says?" —
 * is wrong, and quietly so. Shape describes the primary (usually Hebrew) text.
 * Rashi on Genesis has 2017 Hebrew segments but the 1929 Silbermann English
 * translates only 1239 of them. That download is complete; the translation is
 * simply shorter. Scoring it against the Hebrew count would stamp a perfect
 * download PARTIAL and send you hunting for text that was never there.
 *
 * So completeness is structural: every section fetched without error, and no
 * section that the source says has content came back empty. The ratio against
 * the source is still shown, as context about the version rather than a grade.
 */
function finish(state) {
  el.btnLoad.disabled = false; el.btnStop.disabled = true;
  const expected = book.expectedSegments || 0;
  const allFetched = state.done === book.refs.length && !state.abort;
  const clean = state.failed.length === 0 && state.gaps.length === 0;
  const complete = allFetched && clean && state.segs > 0;

  state.complete = complete;
  state.ratio = expected ? state.segs / expected : null;

  el.badge.className = "badge " + (complete ? "full" : (state.segs ? "part" : "err"));
  el.badge.textContent = complete ? "complete" : (state.segs ? "partial" : "empty");

  const bits = [state.segs.toLocaleString() + " segments",
                state.chars.toLocaleString() + " chars"];
  if (state.abort) bits.push("stopped at " + state.done + "/" + book.refs.length);
  if (state.failed.length) bits.push(state.failed.length + " section(s) failed: " +
    state.failed.slice(0, 4).join(", ") + (state.failed.length > 4 ? ", …" : ""));
  if (state.gaps.length) bits.push(state.gaps.length + " section(s) empty in this version: " +
    state.gaps.slice(0, 4).join(", ") + (state.gaps.length > 4 ? ", …" : ""));
  el.mText.textContent = bits.join(" · ");

  if (!state.segs) {
    say("This version has no text for this work — pick another version above.", "bad");
    setExports(false);
    return;
  }
  setExports(true);

  if (complete) {
    // Say plainly when a version is complete but thinner than the original, so
    // a legitimately shorter translation is not mistaken for a failed download.
    const thin = state.ratio !== null && state.ratio < 0.95;
    say(thin
      ? "Full text of this version — all " + book.refs.length + " sections. It covers " +
        state.segs.toLocaleString() + " of the " + expected.toLocaleString() +
        " segments in the original (" + Math.round(100 * state.ratio) +
        "%); this translation is simply shorter, nothing is missing."
      : "Full text confirmed — all " + book.refs.length + " sections, nothing missing.",
      "ok");
  } else {
    say("Incomplete — downloads will contain exactly what you see above.", "");
  }
}

// ---------------------------------------------------------------- exports

function buildText(fmt) {
  const s = run;
  const head = [
    book.title + (book.heTitle ? "  /  " + book.heTitle : ""),
    "Source: Sefaria (https://www.sefaria.org/" + encodeURIComponent(book.title.replace(/ /g, "_")) + ")",
    "Version: " + (s.versionTitle || s.version),
    "License: " + (s.license || "unknown"),
    "Status: " + (s.complete ? "COMPLETE" : "PARTIAL") +
      " — " + s.done + " of " + book.refs.length + " sections fetched",
    "Coverage: " + s.segs + " segments" +
      (book.expectedSegments
        ? " (the original has " + book.expectedSegments +
          "; translations often cover fewer)" : ""),
    s.failed.length ? "Failed sections: " + s.failed.join(", ") : "",
    s.gaps.length ? "Empty in this version: " + s.gaps.join(", ") : "",
    "Retrieved: " + new Date().toISOString().slice(0, 19).replace("T", " "),
  ].filter(Boolean);

  if (fmt === "json") {
    return JSON.stringify({
      title: book.title, heTitle: book.heTitle,
      version: s.versionTitle || s.version, license: s.license || "unknown",
      source: "https://www.sefaria.org/api",
      complete: !!s.complete, segments: s.segs,
      sectionsFetched: s.done, sectionsTotal: book.refs.length,
      sourceSegments: book.expectedSegments || null,
      failedSections: s.failed, emptySections: s.gaps,
      retrieved: new Date().toISOString(),
      sections: book.refs.map((ref, i) => ({
        ref,
        segments: ((s.sections[i] || {}).segments || [])
          .filter(x => plain(x.text).length)
          .map(x => ({ ref: x.ref, text: plain(x.text), html: x.text })),
      })),
    }, null, 2);
  }

  const md = fmt === "md";
  const out = [];
  out.push(md ? "# " + head[0] : head[0]);
  out.push(md ? "" : "=".repeat(Math.min(head[0].length, 70)));
  for (const line of head.slice(1)) out.push(md ? "> " + line : line);
  out.push("");

  book.refs.forEach((ref, i) => {
    const segs = ((s.sections[i] || {}).segments || []).filter(x => plain(x.text).length);
    if (!segs.length) return;
    out.push(md ? "## " + ref : "\n[" + ref + "]");
    out.push("");
    for (const seg of segs) {
      const label = seg.ref.startsWith(ref) ? seg.ref.slice(ref.length).replace(/^:/, "") : seg.ref;
      const body = plain(seg.text);
      out.push(md ? "**" + (label || "•") + "** " + body : (label ? label + ". " : "") + body);
      out.push("");
    }
  });
  return out.join("\n").replace(/\n{3,}/g, "\n\n") + "\n";
}

function baseName() {
  return slug(book.title) + "__" + slug(run.versionTitle || run.version) +
    (run.complete ? "__full" : "__partial");
}

el.dlTxt.onclick = () => download(baseName() + ".txt", buildText("txt"), "text/plain");
el.dlMd.onclick = () => download(baseName() + ".md", buildText("md"), "text/markdown");
el.dlJson.onclick = () => download(baseName() + ".json", buildText("json"), "application/json");

el.dlSave.onclick = async () => {
  const name = baseName() + ".txt";
  say("saving…");
  try {
    const r = await fetch("/api/save", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name, text: buildText("txt") }),
    });
    const d = await r.json();
    if (!d.ok) throw new Error(d.error);
    say("Saved to " + d.path + " (" + d.bytes.toLocaleString() + " bytes)", "ok");
  } catch (e) {
    say("Save failed: " + e.message, "bad");
  }
};

// ---------------------------------------------------------------- wiring

let bt;
el.bookSearch.oninput = () => { clearTimeout(bt); bt = setTimeout(renderLibrary, 120); };
el.commSearch.oninput = () => renderComms();
el.verSel.onchange = showLicense;
el.btnLoad.onclick = loadFull;
el.btnStop.onclick = () => { if (run) run.abort = true; el.btnStop.disabled = true; };
$("#btnClearSel").onclick = () => {
  bookSel = commSel = null; comms = [];
  el.bookSearch.value = el.commSearch.value = "";
  el.commList.innerHTML = '<div class="hint">Pick a book on the left.</div>';
  el.commCount.textContent = "";
  el.rTitle.textContent = "3 · Full text";
  resetReader();
  el.reader.innerHTML = '<div class="empty"><h3>Reset</h3><p>Pick a book to start again.</p></div>';
  renderLibrary();
};

window.addEventListener("keydown", e => {
  if (e.key === "Escape" && run && !el.btnStop.disabled) el.btnStop.click();
});

loadToc();
</script>
</body>
</html>
